{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtc-ax.internal/schema/MTC-AX-collection-v4.4.schema.json",
  "title": "MTC AX/PI 위클리 사외 수집 계약 v4.4",
  "description": "사외 수집 스크립트가 생성하고 사내 파이프라인이 읽는 단일 JSON 형식. 설계서 v4.4 '공통 JSON 필드 사전'과 1:1로 대응한다. 스키마로 표현할 수 없는 검사(ISO 주차·KST 경계, URL 재계산, 해시 재계산, ID 순번, summary 집계)는 설계서의 '코드 검사' 항목으로 실행한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "revision",
    "issue_week",
    "window_start",
    "window_end_exclusive",
    "lookback_start",
    "generated_at",
    "generator",
    "summary",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "4.4"
    },
    "phase": {
      "enum": [
        "pass1",
        "pass2",
        "merged",
        "intake"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issue_week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
    },
    "window_start": {
      "$ref": "#/$defs/kstMidnight"
    },
    "window_end_exclusive": {
      "$ref": "#/$defs/kstMidnight"
    },
    "lookback_start": {
      "$ref": "#/$defs/kstMidnight"
    },
    "generated_at": {
      "$ref": "#/$defs/offsetDateTime"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "registry_version",
        "config_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "registry_version": {
          "type": "string",
          "minLength": 1
        },
        "config_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "complete",
        "partial",
        "drop",
        "paywall",
        "late_discovery",
        "carried_over"
      ],
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "drop": {
          "type": "integer",
          "minimum": 0
        },
        "paywall": {
          "type": "integer",
          "minimum": 0
        },
        "late_discovery": {
          "type": "integer",
          "minimum": 0
        },
        "carried_over": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resurvey": {
      "$ref": "#/$defs/resurvey"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "offsetDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "kstMidnight": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00\\+09:00$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "topicCode": {
      "enum": [
        "T1_CHIPMAKER",
        "T2_EQUIPMENT",
        "T3_SOLUTION",
        "T4_PHYSICAL_AI"
      ]
    },
    "recoveryCode": {
      "enum": [
        "ACCESS_BLOCKED",
        "FETCH_FAILED",
        "BODY_MISSING",
        "BODY_TRUNCATED",
        "TABLE_MISSING",
        "DATE_UNCERTAIN",
        "MERGE_CONFLICT"
      ]
    },
    "terminalCode": {
      "enum": [
        "PAYWALL",
        "OUT_OF_WINDOW",
        "UNTRUSTED_SOURCE"
      ]
    },
    "resurvey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_count",
        "after_count",
        "topics_checked",
        "report"
      ],
      "properties": {
        "before_count": {
          "type": "integer",
          "minimum": 0
        },
        "after_count": {
          "type": "integer",
          "minimum": 0
        },
        "topics_checked": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "method",
              "result"
            ],
            "properties": {
              "topic": {
                "$ref": "#/$defs/topicCode"
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "report": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(P|T)[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "paragraph",
            "heading",
            "caption",
            "note",
            "table"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^T[1-9][0-9]*$"
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "pattern": "^P[1-9][0-9]*$"
              }
            }
          }
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "extent",
        "scope_note",
        "extractor",
        "blocks",
        "lead_ids",
        "utf8_bytes",
        "sha256"
      ],
      "properties": {
        "scope": {
          "enum": [
            "article",
            "pdf",
            "video_description",
            "transcript",
            "unknown"
          ]
        },
        "extent": {
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "scope_note": {
          "$ref": "#/$defs/nullableString"
        },
        "extractor": {
          "$ref": "#/$defs/nullableString"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "lead_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P[1-9][0-9]*$"
          }
        },
        "utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "extent": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "blocks": {
                "maxItems": 0
              },
              "lead_ids": {
                "maxItems": 0
              },
              "utf8_bytes": {
                "const": 0
              },
              "sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "blocks": {
                "minItems": 1
              },
              "utf8_bytes": {
                "minimum": 1
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "agent",
        "at",
        "url",
        "http_status",
        "observation"
      ],
      "properties": {
        "pass": {
          "enum": [
            1,
            2
          ]
        },
        "agent": {
          "enum": [
            "script",
            "browser",
            "manual"
          ]
        },
        "at": {
          "$ref": "#/$defs/offsetDateTime"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "agent",
        "source_id",
        "query"
      ],
      "properties": {
        "route": {
          "enum": [
            "registry",
            "llm_search",
            "manual"
          ]
        },
        "agent": {
          "enum": [
            "script",
            "gpt",
            "gemini",
            "manual"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/nullableString"
        },
        "query": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "source_url",
        "normalized_url",
        "title",
        "publisher",
        "author",
        "language",
        "source_type",
        "published_date",
        "published_at",
        "change_at",
        "change_note",
        "late_discovery",
        "discovery",
        "event_key",
        "track",
        "topic_hints",
        "source_tier",
        "body",
        "status",
        "reason_codes",
        "attempts"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^url1_[0-9a-f]{64}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "normalized_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "publisher": {
          "$ref": "#/$defs/nullableString"
        },
        "author": {
          "$ref": "#/$defs/nullableString"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "source_type": {
          "enum": [
            "company_official",
            "standards_body",
            "academic",
            "research_lab",
            "press",
            "other"
          ]
        },
        "published_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/offsetDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/offsetDateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_note": {
          "$ref": "#/$defs/nullableString"
        },
        "late_discovery": {
          "type": "boolean"
        },
        "discovery": {
          "$ref": "#/$defs/discovery"
        },
        "event_key": {
          "type": "null",
          "description": "사외에서는 항상 null. 사건 묶음은 사내에서 부여한다."
        },
        "track": {
          "enum": [
            "A",
            "B"
          ]
        },
        "topic_hints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/topicCode"
          }
        },
        "source_tier": {
          "enum": [
            "primary",
            "named_secondary",
            "unverified"
          ]
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "drop"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/recoveryCode"
              },
              {
                "$ref": "#/$defs/terminalCode"
              }
            ]
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "published_date": {
                "type": "string"
              },
              "reason_codes": {
                "maxItems": 0
              },
              "body": {
                "properties": {
                  "extent": {
                    "const": "full"
                  },
                  "lead_ids": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/recoveryCode"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "drop"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/terminalCode"
                }
              }
            }
          }
        }
      ]
    }
  }
}
